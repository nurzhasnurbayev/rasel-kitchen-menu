/**
 * Cloudflare Worker configuration (Workers with static assets).
 * Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Bindings declared here must match the `Env` interface in src/app.d.ts.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rasel-kitchen-menu",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_als"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "rasel-kitchen-menu",
			// Created with `npx wrangler d1 create rasel-kitchen-menu` (region EEUR).
			"database_id": "d2ce37dc-7d2d-4a44-9b31-b4880c3eef85",
			"migrations_dir": "drizzle/migrations"
		}
	],

	"r2_buckets": [
		{
			// Dish photos. Created with `npx wrangler r2 bucket create rasel-kitchen-photos`.
			"binding": "PHOTOS",
			"bucket_name": "rasel-kitchen-photos"
		}
	]
}
