/**
 * Cloudflare Worker configuration (Workers with static assets).
 * Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Bindings declared here must match the `Env` interface in src/app.d.ts.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rasel-kitchen-menu",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_als"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,

	// The menu's domain. `wrangler deploy` attaches both names to this Worker, creating their DNS
	// records and certificates. The Worker redirects www. (and workers.dev) to CANONICAL_HOST.
	"routes": [
		{ "pattern": "rasel-kitchen.app", "custom_domain": true },
		{ "pattern": "www.rasel-kitchen.app", "custom_domain": true }
	],
	// Kept on so older links to the workers.dev address still work: they redirect to the domain.
	"workers_dev": true,

	// None of these is secret.
	"vars": {
		// The menu's public address (no https://). See src/lib/server/canonical.ts.
		"CANONICAL_HOST": "rasel-kitchen.app",
		// Cloudflare Access for /admin (see "Admin panel" in the README). Until both are filled in,
		// /admin answers 503 in production.
		// The Cloudflare One (Zero Trust) team domain.
		"ACCESS_TEAM_DOMAIN": "quiet-thunder-8c55.cloudflareaccess.com",
		// Cloudflare One → Access controls → Applications → Rasel menu admin → Additional settings →
		// Application Audience (AUD) Tag. It only says which app a login is for.
		"ACCESS_AUD": "2821132641ca740c0e5cd62f4ed713425775cb29657bf8f786380c66f88c8a38",
		// The domain's zone (dashboard → rasel-kitchen.app → Overview → API), for the cache purge.
		"CLOUDFLARE_ZONE_ID": "7be470d63c5d913704e628195cfe6ba5"
	},
	// Secret (set with `npx wrangler secret put CLOUDFLARE_API_TOKEN`, never in this file): an API
	// token allowed to purge this zone's cache, so admin saves show on the menu right away.

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "rasel-kitchen-menu",
			// Created with `npx wrangler d1 create rasel-kitchen-menu` (region EEUR).
			"database_id": "d2ce37dc-7d2d-4a44-9b31-b4880c3eef85",
			"migrations_dir": "drizzle/migrations"
		}
	],

	"r2_buckets": [
		{
			// Dish photos. Created with `npx wrangler r2 bucket create rasel-kitchen-photos`.
			"binding": "PHOTOS",
			"bucket_name": "rasel-kitchen-photos"
		}
	]
}
